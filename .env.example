# Optional server-side market data credentials. Leave blank for synthetic mode.
# Copy the structure into .env.local and restrict that file to mode 600.
KITE_API_KEY=
KITE_API_SECRET=
# Optional alternative to browser authentication. Tokens expire daily.
KITE_ACCESS_TOKEN=

# Optional research and forward-monitoring model credentials. Choose an available structured-output Responses model.
ARTHA_AI_API_KEY=
ARTHA_AI_MODEL=

# Optional Phase 4 Telegram delivery. Saving credentials does not enable delivery.
# Enable only through the consent-based Forward paper configuration.
ARTHA_TELEGRAM_BOT_TOKEN=
ARTHA_TELEGRAM_CHAT_ID=
